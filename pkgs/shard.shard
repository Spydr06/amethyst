{ lib, pkgs, config, ... }:
lib.mkPackage rec {
    name = "shard";
    version = "0.0.1";

    buildDir = lib.realpath "./build";
    sourceDir = builtins.toPath "${pkgs.amethyst-source}/source/shard";

    makeTarget = "bin";
    installTarget = "install-bin";

    env = {
        PREFIX = builtins.toString lib.prefix;
        CFLAGS = "-specs=${lib.prefix}/usr/lib/musl-gcc.specs -D_SHARD_NO_FFI -D_SHARD_NO_LIBEDIT -g";
        LDFLAGS = "-static -specs=${lib.prefix}/usr/lib/musl-gcc.specs";
    };

    buildDependencies = with pkgs; [
        musl
        #getopt
        libshard
    ];

    buildPhase = lib.make [ "-C" sourceDir makeTarget ];

    installPhase = lib.make [ "-C" sourceDir installTarget "PREFIX=${env.PREFIX}" ];
}

